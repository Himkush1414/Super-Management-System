# NR Management (mobile) — variable NAMES only. Never put real values here.
# Set the values as EAS environment variables (environment: preview), e.g.
#   npx eas-cli env:create --environment preview --name EXPO_PUBLIC_SUPABASE_URL --value ... --visibility plaintext
# For local runs, copy to .env.local (gitignored).

# Website the app wraps (defaults to the production URL when unset)
EXPO_PUBLIC_WEB_URL=

# Supabase public project URL and anon key (public by design; still not committed)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# EAS file variable (secret): google-services.json from Firebase. Enables push.
GOOGLE_SERVICES_JSON=

# EAS project id (written by `eas init`)
EAS_PROJECT_ID=
