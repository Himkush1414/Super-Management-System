{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["App.js", "index.js", "app.config.js", "src/**/*.js", "test/**/*.mjs", "scripts/**/*.mjs"]
}
