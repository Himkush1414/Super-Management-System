# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files (can opt-in for committing if needed)
.env*
# ...but keep the no-secrets template
!.env.example

# vercel
.vercel

# supabase CLI local state (never commit — linked-project info, versions, pooler url)
supabase/.temp
supabase/.branches
supabase/.env

# contains real fixed-account login passwords — never commit (see seed.sql.example)
supabase/seed.sql
supabase/hosted-bootstrap.sql

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
