NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# ⚠️ FILL THIS IN: Supabase Dashboard -> Project Settings -> API -> "anon / public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required — used by the phone sign-up path (auth.admin.createUser) and by
# the direct-messaging cleanup Edge Function. Never exposed to the client.
# Dashboard -> Project Settings -> API -> "service_role" key
SUPABASE_SERVICE_ROLE_KEY=

# Required — the one seeded Head Admin's email. The login action compares
# against this (case-insensitively) to silently skip the OTP second factor
# for that account only. Must match supabase/seed.sql exactly.
HEAD_ADMIN_EMAIL=manikrana831@gmail.com

# Public site origin (used in emails / OTP redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
