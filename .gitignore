# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log

# env files (can opt-in for committing if needed)
.env*
# ...but keep the no-secrets template
!.env.example

# vercel
.vercel

# supabase CLI local state (never commit — linked-project info, versions, pooler url)
supabase/.temp
supabase/.branches
supabase/.env

# contain real fixed-account login PINs — never commit (see seed.sql.example)
supabase/seed.sql
supabase/hosted-bootstrap.sql
supabase/hosted-pins.sql
supabase/hosted-dispatchers.sql

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# sample PDFs generated from fixtures for review (never real data)
sample-pdfs/

# local tool settings (per machine, never shared)
.claude/settings.local.json

# security audit notes that name real findings: kept off the public repo
docs/SECURITY-FINDINGS.md

# keys, signing files and credentials, anywhere in the repo
*.jks
*.keystore
*.p8
*.p12
*.key
google-services.json
GoogleService-Info.plist
*service-account*.json
*-firebase-adminsdk-*.json

# database dumps and backups (real data)
*.dump
*.backup
*.sql.gz
backups/

# app builds
*.apk
*.aab
